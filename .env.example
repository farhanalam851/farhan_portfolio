# Copy these into your host's "Environment variables" screen. Never commit real values.
DEBUG=0
SECRET_KEY=generate-a-long-random-string
ALLOWED_HOSTS=yourname.com,www.yourname.com
CSRF_TRUSTED_ORIGINS=https://yourname.com,https://www.yourname.com
DATABASE_URL=postgres://user:password@host:5432/dbname   # on Vercel, the Neon integration sets this for you

# First-deploy admin login (build.sh creates it)
DJANGO_SUPERUSER_USERNAME=farhan
DJANGO_SUPERUSER_EMAIL=farhanalam8510@gmail.com
DJANGO_SUPERUSER_PASSWORD=choose-a-strong-password

# Email notifications for contact-form enquiries (Gmail needs an App Password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# Google Analytics 4 Measurement ID (looks like G-ABC123XYZ). Leave empty to switch analytics off.
# The tracking script loads only after a visitor clicks "Accept analytics" in the cookie banner.
GA_MEASUREMENT_ID=
