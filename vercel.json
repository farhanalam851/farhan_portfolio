{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash vercel_build.sh",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{staticfiles,static,templates,core,config}/**",
      "maxDuration": 30
    }
  }
}
